# Origin of the management listener of pacod-gw-core. Read on the server only.
GATEWAY_API_URL=http://127.0.0.1:28081

# Origin of the Prometheus server that scrapes the gateway. Optional: the Metrics page needs it.
PROMETHEUS_URL=

# The data plane as applications reach it, shown to platform admins on the System page.
# Optional; the console never calls it. scripts/dev-core.sh serves it on 28080.
PGW_API_URL=http://127.0.0.1:28080
