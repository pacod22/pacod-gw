# Development variables for running the binaries directly (cargo run), outside Docker.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a          # the binaries do not read .env themselves
#   cargo run -p pacod-gw-core -- serve
#
# The values fit the development stack, which provides PostgreSQL, ClickHouse, the mock
# provider and the OTel collector on these host ports:
#
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml up -d --build --wait
#
# The stack also runs core, analytics and ui in containers, on the same host ports as below.
# Stop the one you want to run yourself first, for example:
#
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml stop core
#
# Everything here is a development default and is public. The production stack takes its
# settings from deploy/.env (see deploy/.env.example). Providers and their API keys are not
# configured here: they live in the database and are entered in the console.

# ---------------------------------------------------------------------------------------------
# pacod-gw-core
# ---------------------------------------------------------------------------------------------

# all = data plane and management API; gateway = data plane only; admin = management API only.
PGW_ROLE=all

# Listen addresses: data plane, management API, Prometheus metrics. The usual ports
# (8080, 8081, 9100) are taken on the development machine.
PGW_LISTEN=127.0.0.1:18080
PGW_ADMIN_LISTEN=127.0.0.1:18081
PGW_METRICS_LISTEN=127.0.0.1:19100

# PostgreSQL of the development stack. The core migrates its schema at start.
DATABASE_URL=postgres://pacod_gw:pacod_gw_dev_postgres@127.0.0.1:15433/pacod_gw

# Key-encryption key, base64 of 32 bytes (openssl rand -base64 32). This is the development
# stack's key, so that a core run from here can read what the containerised one stored.
PGW_KEK=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
# Name stored with every record encrypted under PGW_KEK.
PGW_KEK_ID=dev
# Earlier keys, "id=base64key,id=base64key". Only during a rotation.
PGW_KEK_OLD=

# HMAC pepper under which gateway keys and admin tokens are stored. At least 16 characters.
PGW_KEY_PEPPER=dev-only-pepper-do-not-use-in-prod

# Base URL of the analytics service. Leave empty for the minimal setup (no reports).
PGW_ANALYTICS_URL=http://127.0.0.1:18090
# Shared secret between core and analytics. At least 16 characters.
PGW_INTERNAL_TOKEN=dev-only-internal-token-0123456789

# Directory for the event spool. Must be writable.
PGW_SPOOL_DIR=data/spool

# The first administrator, created when no user exists yet.
PGW_ADMIN_EMAIL=admin@example.com
PGW_ADMIN_PASSWORD=pacod-gw-dev

# OTLP over HTTP endpoint for traces. The development stack does not publish its collector;
# leave this empty unless you run one on the host.
PGW_OTLP_ENDPOINT=

# Private hosts or CIDR ranges where providers may live, comma separated. The mock provider
# of the development stack listens on 127.0.0.1:19000.
PGW_EGRESS_ALLOW_PRIVATE=127.0.0.1

# Optional bootstrap file (see config/gateway.example.toml). When unset, the core reads
# config/gateway.toml if that file exists.
# PGW_CONFIG=config/gateway.toml

# ---------------------------------------------------------------------------------------------
# pacod-gw-analytics
# ---------------------------------------------------------------------------------------------

ANALYTICS_LISTEN=127.0.0.1:18090

# ClickHouse of the development stack (HTTP interface). The service creates the database
# and migrates its tables at start.
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_DATABASE=pacod_gw
CLICKHOUSE_USER=pacod_gw
CLICKHOUSE_PASSWORD=pacod_gw_dev_clickhouse

# The core's management API, as the analytics jobs reach it.
PGW_CORE_ADMIN_URL=http://127.0.0.1:18081

# ---------------------------------------------------------------------------------------------
# ui (npm run dev in ui/)
# ---------------------------------------------------------------------------------------------

# The management API. Used on the server side of the console only.
GATEWAY_API_URL=http://127.0.0.1:18081

# ---------------------------------------------------------------------------------------------
# Tests and logging
# ---------------------------------------------------------------------------------------------

# A PostgreSQL server on which the integration tests may create databases, and the HTTP
# interface of a ClickHouse whose default user needs no password. Not the development
# stack's databases: start throwaway ones for the tests.
# GW_TEST_DATABASE_URL=postgres://postgres:test@localhost:25433/gw
# GW_TEST_CLICKHOUSE_URL=http://localhost:28123

# Log filter (tracing-subscriber syntax).
RUST_LOG=info
# "json" writes one JSON object per line; anything else plain text.
PGW_LOG_FORMAT=text
ANALYTICS_LOG_FORMAT=text

# ---------------------------------------------------------------------------------------------
# Live smoke test (make smoke-live)
# ---------------------------------------------------------------------------------------------

# Real provider keys, for a few tiny calls through a running gateway. Only
# scripts/smoke-live.sh reads them; it hands them to the gateway's management API as provider
# credentials and never prints them. The gateway itself reads no provider key from the
# environment. A provider without a key is skipped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
