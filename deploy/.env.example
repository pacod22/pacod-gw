# Settings and secrets of the production stack (deploy/docker-compose.yml).
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# deploy/.env is git-ignored and must never be committed, copied into an image or put into a
# backup. Docker Compose reads it because it sits next to docker-compose.yml. The stack
# refuses to start while a required secret is empty (the "preflight" service names it).
#
# To fill every secret at once, run this in the repository root and paste the output over
# the matching lines:
#
#   printf 'POSTGRES_PASSWORD=%s\n'      "$(openssl rand -hex 24)"
#   printf 'CLICKHOUSE_PASSWORD=%s\n'    "$(openssl rand -hex 24)"
#   printf 'PGW_KEK=%s\n'                "$(openssl rand -base64 32)"
#   printf 'PGW_KEY_PEPPER=%s\n'         "$(openssl rand -base64 32)"
#   printf 'PGW_INTERNAL_TOKEN=%s\n'     "$(openssl rand -hex 32)"
#   printf 'PGW_ADMIN_PASSWORD=%s\n'     "$(openssl rand -base64 18)"
#   printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -base64 18)"
#
# Write values without quotes. A "$" in a value must be written as "$$".

# ---------------------------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------------------------

# Registry and path in front of the image names, with the trailing slash, for example
# "registry.example.com/platform/". Empty: the images pacod-gw-core, pacod-gw-analytics and
# pacod-gw-ui are expected on this host (built here, see docs/runbook.md).
PGW_REGISTRY=

# Tag of the three pacod-gw images. An upgrade changes this line.
PGW_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# Host names, TLS and ports
# ---------------------------------------------------------------------------------------------

# Host name of the data plane. Applications use https://<this>/v1, /gw/v1 and /proxy.
PGW_API_HOST=api.localhost

# Host name of the admin console.
PGW_CONSOLE_HOST=console.localhost

# Where the certificates come from.
#   internal            Caddy's own certificate authority (localhost, tests).
#   an e-mail address   Let's Encrypt, for real domains; the address is the account contact.
PGW_TLS=internal

# Host ports that Caddy publishes. Let's Encrypt needs 80 and 443.
PGW_HTTP_PORT=80
PGW_HTTPS_PORT=443

# Largest request body Caddy accepts on the data plane. Keep it above the core's own limit
# (32 MiB unless a config file changes [limits] max_body_bytes).
PGW_MAX_BODY=64MB

# The gateway instances Caddy sends data-plane requests to, separated by spaces. Leave it
# unset for the compose files' own default: "core:8080", or with docker-compose.scale.yml
# "gateway-1:8080 gateway-2:8080". Set it when gateways on other machines join; list the
# local ones too (docs/runbook.md, "Scaling"):
# PGW_DATA_UPSTREAMS=gateway-1:8080 gateway-2:8080 10.0.0.11:8080 10.0.0.12:8080

# Client addresses that may open Grafana at https://<console host>/grafana/ (and the
# management API, if that block in caddy/Caddyfile is enabled). Space-separated CIDR ranges,
# or "private_ranges" for all private networks. The default lets nobody in.
PGW_ADMIN_ALLOW_CIDRS=127.0.0.1/32

# ---------------------------------------------------------------------------------------------
# Secrets of the gateway
# ---------------------------------------------------------------------------------------------

# Key-encryption key: provider credentials in PostgreSQL are encrypted under it. Base64 of
# 32 bytes. Without this exact value the stored credentials cannot be read again, and a
# database backup is useless. Store a copy outside this host and outside the backups.
#   openssl rand -base64 32
PGW_KEK=

# Name of the key above, stored with every encrypted record. Change it when the key changes.
PGW_KEK_ID=2026-10

# Earlier key-encryption keys, kept until every record has been re-encrypted:
# "id=base64key,id=base64key". Empty unless a rotation is under way (docs/runbook.md).
PGW_KEK_OLD=

# Pepper for the HMAC under which gateway keys and admin tokens are stored. At least
# 16 characters. Changing it invalidates every gateway key and admin token.
#   openssl rand -base64 32
PGW_KEY_PEPPER=

# Shared secret between the core and the analytics service. At least 16 characters.
#   openssl rand -hex 32
PGW_INTERNAL_TOKEN=

# The first platform administrator. Created at the first start, when no user exists yet;
# ignored afterwards. Change the password in the console after the first login.
#   openssl rand -base64 18
PGW_ADMIN_EMAIL=admin@example.com
PGW_ADMIN_PASSWORD=

# Hosts or CIDR ranges on private networks where providers may live, comma separated, for
# example a local model server: "ollama.internal,10.20.0.0/24". Everything else that is
# private, link-local or loopback is refused as a provider address, and as a source of the
# price job.
PGW_EGRESS_ALLOW_PRIVATE=

# ---------------------------------------------------------------------------------------------
# Several instances (docs/runbook.md, "Scaling")
# ---------------------------------------------------------------------------------------------

# Load balancers whose X-Forwarded-For the gateways believe: addresses, CIDR ranges, or
# "private_ranges". Unset: private_ranges, which covers Caddy on the compose networks.
# PGW_TRUSTED_PROXIES=private_ranges

# Connections each core keeps to PostgreSQL. Unset: 10, and 4 for gateways. PostgreSQL
# accepts 100 in all (docker-compose.yml); the management instance, every gateway and a
# backup must fit.
# PGW_DB_MAX_CONNECTIONS=

# With docker-compose.hub.yml: the private address on which this host offers PostgreSQL,
# the analytics service and the trace collector to gateways on other machines, and the
# ports. Never a public address: the network between the machines must be private (a VLAN,
# a cloud VPC or a VPN such as WireGuard). Unset: 127.0.0.1, which keeps them local.
# PGW_CLUSTER_BIND=10.0.0.10
# PGW_CLUSTER_POSTGRES_PORT=5432
# PGW_CLUSTER_ANALYTICS_PORT=8090
# PGW_CLUSTER_OTLP_PORT=4318

# ---------------------------------------------------------------------------------------------
# Account emails: email verification and password reset
# ---------------------------------------------------------------------------------------------

# SMTP server. Empty: no email is sent; new users need no verification and an administrator
# resets forgotten passwords. Check the settings with:
#   docker compose -f deploy/docker-compose.yml run --rm --no-deps core email-check
PGW_SMTP_HOST=
# Empty: 587 for starttls, 465 for tls, 25 for none.
PGW_SMTP_PORT=
# starttls (required upgrade, port 587), tls (TLS from the first byte, port 465), or none
# (only for a relay on the same host).
PGW_SMTP_TLS=starttls
PGW_SMTP_USERNAME=
PGW_SMTP_PASSWORD=
# Sender. Empty address: the SMTP username.
PGW_EMAIL_FROM_ADDRESS=
PGW_EMAIL_FROM_NAME=PACOD AI Gateway
# The console's address as users reach it, for the links in the emails. Required when
# PGW_SMTP_HOST is set.
PGW_CONSOLE_URL=https://console.localhost

# ---------------------------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------------------------

# Password of the PostgreSQL user "pacod_gw". It becomes part of a URL: use only letters,
# digits and . _ ~ -. Applied when the data volume is created; changing it later needs
# ALTER ROLE as well.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Password of the ClickHouse user "pacod_gw". Same character rule.
#   openssl rand -hex 24
CLICKHOUSE_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------------

# Grafana administrator. The password is applied when Grafana creates its database, on the
# first start; later changes are made in Grafana.
#   openssl rand -base64 18
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Public address of Grafana: https://<console host>/grafana/ (add the port if PGW_HTTPS_PORT
# is not 443).
GRAFANA_ROOT_URL=https://console.localhost/grafana/

# How long Prometheus keeps metrics.
PROMETHEUS_RETENTION=30d

# Log filter of the core and the analytics service (tracing-subscriber syntax).
RUST_LOG=info

# Log format of the core and the analytics service: "json" writes one JSON object per line,
# anything else plain text.
PGW_LOG_FORMAT=json

# ---------------------------------------------------------------------------------------------
# Tester (the console's Testing page, platform admins only)
# ---------------------------------------------------------------------------------------------
# A scripted mock provider for mock mode, as the gateway reaches it. Empty: only live mode is
# offered, with models that are already set up. The development stack sets both to gw-mock.
TESTER_MOCK_URL=
# The mock as the tester reaches it, to script failures. Empty: the same as TESTER_MOCK_URL.
TESTER_MOCK_CONTROL_URL=
