# Settings and secrets of the production stack (deploy/docker-compose.yml, the gateway's own
# services, and deploy/docker-compose.standalone.yml, its copies of the shared components).
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# deploy/.env is git-ignored and must never be committed, copied into an image or put into a
# backup. Docker Compose reads it because it sits next to docker-compose.yml. The stack
# refuses to start while a required secret is empty (the "gw-preflight" service names it).
#
# To fill every secret at once, run this in the repository root and paste the output over
# the matching lines:
#
#   printf 'POSTGRES_PASSWORD=%s\n'      "$(openssl rand -hex 24)"
#   printf 'GW_DB_PASSWORD=%s\n'         "$(openssl rand -hex 24)"
#   printf 'CLICKHOUSE_PASSWORD=%s\n'    "$(openssl rand -hex 24)"
#   printf 'PGW_VALKEY_PASSWORD=%s\n'    "$(openssl rand -hex 24)"
#   printf 'PGW_KEK=%s\n'                "$(openssl rand -base64 32)"
#   printf 'PGW_KEY_PEPPER=%s\n'         "$(openssl rand -base64 32)"
#   printf 'PGW_INTERNAL_TOKEN=%s\n'     "$(openssl rand -hex 32)"
#   printf 'PGW_ADMIN_PASSWORD=%s\n'     "$(openssl rand -base64 18)"
#   printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$(openssl rand -base64 18)"
#   printf 'TESTER_LOAD_TOKEN=%s\n'      "$(openssl rand -hex 32)"   # only with load tests
#
# Write values without quotes. A "$" in a value must be written as "$$".

# ---------------------------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------------------------

# Registry and path in front of the image names, with the trailing slash, for example
# "registry.example.com/platform/". Empty: the images pacod-gw-core, pacod-gw-analytics and
# pacod-gw-ui are expected on this host (built here, see docs/runbook.md).
PGW_REGISTRY=

# Tag of the three pacod-gw images. An upgrade changes this line.
PGW_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# Host names, TLS and ports
# ---------------------------------------------------------------------------------------------

# Host name of the data plane. Applications use https://<this>/v1, /gw/v1 and /proxy.
PGW_API_HOST=api.localhost

# Host name of the admin console.
PGW_CONSOLE_HOST=console.localhost

# Where the certificates come from.
#   internal            Caddy's own certificate authority (localhost, tests).
#   an e-mail address   Let's Encrypt, for real domains; the address is the account contact.
PGW_TLS=internal

# Host ports that Caddy publishes. Let's Encrypt needs 80 and 443.
PGW_HTTP_PORT=80
PGW_HTTPS_PORT=443

# Largest request body Caddy accepts on the data plane. Keep it above the core's own limit
# (32 MiB unless a config file changes [limits] max_body_bytes).
PGW_MAX_BODY=64MB

# The gateway instances Caddy sends data-plane requests to, separated by spaces. Leave it
# unset for the compose files' own default: "pacod-gw:8080", or with docker-compose.scale.yml
# "gw-gateway-1:8080 gw-gateway-2:8080". Set it when gateways on other machines join; list the
# local ones too (docs/runbook.md, "Scaling"):
# PGW_DATA_UPSTREAMS=gw-gateway-1:8080 gw-gateway-2:8080 10.0.0.11:8080 10.0.0.12:8080

# Client addresses that may open Grafana at https://<console host>/grafana/ (and the
# management API, if that block in platform/caddy/gw.caddy is enabled). Space-separated CIDR ranges,
# or "private_ranges" for all private networks. The default lets nobody in.
PGW_ADMIN_ALLOW_CIDRS=127.0.0.1/32

# ---------------------------------------------------------------------------------------------
# Secrets of the gateway
# ---------------------------------------------------------------------------------------------

# Key-encryption key: provider credentials in PostgreSQL are encrypted under it. Base64 of
# 32 bytes. Without this exact value the stored credentials cannot be read again, and a
# database backup is useless. Store a copy outside this host and outside the backups.
#   openssl rand -base64 32
PGW_KEK=

# Name of the key above, stored with every encrypted record. Change it when the key changes.
PGW_KEK_ID=2026-10

# Earlier key-encryption keys, kept until every record has been re-encrypted:
# "id=base64key,id=base64key". Empty unless a rotation is under way (docs/runbook.md).
PGW_KEK_OLD=

# Pepper for the HMAC under which gateway keys and admin tokens are stored. At least
# 16 characters. Changing it invalidates every gateway key and admin token.
#   openssl rand -base64 32
PGW_KEY_PEPPER=

# Shared secret between the core and the analytics service. At least 16 characters.
#   openssl rand -hex 32
PGW_INTERNAL_TOKEN=

# The first platform administrator. Created at the first start, when no user exists yet;
# ignored afterwards. Change the password in the console after the first login.
#   openssl rand -base64 18
PGW_ADMIN_EMAIL=admin@example.com
PGW_ADMIN_PASSWORD=

# Hosts or CIDR ranges on private networks where providers may live, comma separated, for
# example a local model server: "ollama.internal,10.20.0.0/24". Everything else that is
# private, link-local or loopback is refused as a provider address, and as a source of the
# price job.
PGW_EGRESS_ALLOW_PRIVATE=

# ---------------------------------------------------------------------------------------------
# Several instances (docs/runbook.md, "Scaling")
# ---------------------------------------------------------------------------------------------

# Load balancers whose X-Forwarded-For the gateways believe: addresses, CIDR ranges, or
# "private_ranges". Unset: private_ranges, which covers Caddy on pacod-net.
# PGW_TRUSTED_PROXIES=private_ranges

# Connections each core keeps to PostgreSQL. Unset: 10, and 4 for gateways. PostgreSQL
# accepts 100 in all (docker-compose.standalone.yml); the management instance, every gateway and a
# backup must fit.
# PGW_DB_MAX_CONNECTIONS=

# With docker-compose.hub.yml: the private address on which this host offers PostgreSQL,
# the analytics service, the trace collector and the response cache's Valkey to gateways on
# other machines, and the ports. Never a public address: the network between the machines must
# be private (a VLAN, a cloud VPC or a VPN such as WireGuard). Unset: 127.0.0.1, which keeps
# them local.
# PGW_CLUSTER_BIND=10.0.0.10
# PGW_CLUSTER_POSTGRES_PORT=5432
# PGW_CLUSTER_ANALYTICS_PORT=8090
# PGW_CLUSTER_OTLP_PORT=4318
# Valkey's TLS port: its certificate and key go into PGW_VALKEY_TLS_DIR (deploy/valkey/tls
# unset; deploy/valkey/tls/README.md).
# PGW_CLUSTER_VALKEY_PORT=6380
# PGW_VALKEY_TLS_DIR=./valkey/tls

# ---------------------------------------------------------------------------------------------
# Account emails: email verification and password reset
# ---------------------------------------------------------------------------------------------

# SMTP server. Empty: no email is sent; new users need no verification and an administrator
# resets forgotten passwords. Check the settings with:
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.standalone.yml \
#     run --rm --no-deps pacod-gw email-check
PGW_SMTP_HOST=
# Empty: 587 for starttls, 465 for tls, 25 for none.
PGW_SMTP_PORT=
# starttls (required upgrade, port 587), tls (TLS from the first byte, port 465), or none
# (only for a relay on the same host).
PGW_SMTP_TLS=starttls
PGW_SMTP_USERNAME=
PGW_SMTP_PASSWORD=
# Sender. Empty address: the SMTP username.
PGW_EMAIL_FROM_ADDRESS=
PGW_EMAIL_FROM_NAME=pacod-gw
# The console's address as users reach it, for the links in the emails. Required when
# PGW_SMTP_HOST is set.
PGW_CONSOLE_URL=https://console.localhost

# Alerts (runbook, section 10). Alertmanager sends them with the SMTP account above to this
# address (several separated by commas), and to the webhook when one is named. Both empty:
# alerts are only shown in Prometheus and Grafana.
PGW_ALERT_EMAIL_TO=
PGW_ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------------------------
# Signing in: pacod-id (runbook, section 16)
# ---------------------------------------------------------------------------------------------

# Who signs people in to the console: "local" (the gateway itself, the default) or "oidc"
# (pacod-id, the "pacod-id" service). pacod-id runs either way; moving a gateway's people to
# it is runbook section 16.
PGW_AUTH=local

# pacod-id's host name, where people sign in. Like the two above, it must resolve to this host.
PGW_ID_HOST=id.localhost

# Only when Caddy is published on another port than 443 (PGW_HTTPS_PORT): pacod-id's issuer
# with that port, https://<PGW_ID_HOST>:<port>; give PGW_CONSOLE_URL above the port too.
# Empty: https://<PGW_ID_HOST>. The issuer is in every token: changing it signs everyone out.
PGW_ID_ISSUER=

# Password of the PostgreSQL role "pacod_id", which owns the database "pacod_id". Same
# character rule as POSTGRES_PASSWORD. The pacod-db-init service sets it at every start.
#   openssl rand -hex 24
PID_DB_PASSWORD=

# pacod-id's key-encryption key (its signing keys are sealed with it) and its id, and the
# pepper of its service tokens. As with PGW_KEK: keep a copy, a lost key cannot be recovered.
#   openssl rand -base64 32
PID_KEK=
PID_KEK_ID=2026-10
PID_KEK_OLD=
#   openssl rand -hex 32
PID_TOKEN_PEPPER=

# The secrets of pacod-id's three clients: the core, the console and the tester. And the key
# of the console's session cookie (changing it signs everyone out of the console).
#   openssl rand -hex 32   (each)
PGW_ID_CLIENT_SECRET=
PGW_UI_CLIENT_SECRET=
TESTER_ID_CLIENT_SECRET=
PGW_UI_SESSION_SECRET=

# pacod-id's first administrator, on a new installation only: a platform admin of the gateway
# with this address and password (at least 12 characters). Leave both empty when the
# gateway's own people are moved to pacod-id (runbook, section 16), and empty them once the
# account exists.
PID_BOOTSTRAP_ADMIN_EMAIL=
PID_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Stores
# ---------------------------------------------------------------------------------------------

# Password of the PostgreSQL user "postgres", the superuser of the gateway's own PostgreSQL.
# Only pacod-db-init logs in with it; the core never sees it. Use only letters, digits and
# . _ ~ -. Applied when the data volume is created; changing it later needs ALTER ROLE as well
# (docs/runbook.md, section 8).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Password of the PostgreSQL user "pacod_gw", which the core connects with. It owns the
# gateway's database and is not a superuser. pacod-db-init sets it at every start. It becomes
# part of a URL: same character rule. It must differ from POSTGRES_PASSWORD. An installation
# made while pacod_gw was the superuser has none yet: docs/runbook.md, section 6.
#   openssl rand -hex 24
GW_DB_PASSWORD=

# Password of the ClickHouse user "pacod_gw". Same character rule.
#   openssl rand -hex 24
CLICKHOUSE_PASSWORD=

# Password of Valkey (gw-valkey), the response cache's store: the answers the gateways keep and
# give again to a call that asks the same (docs/plugin-concept.md, section 15). Same character
# rule. Nothing it holds is written to disk.
#   openssl rand -hex 24
PGW_VALKEY_PASSWORD=
# The most it holds; the least recently used answers go first. Its container's memory limit is
# 512 MB.
# PGW_VALKEY_MAXMEMORY=384mb
# The mode the core installs the response cache with on its first start: off (the default),
# shadow or enforce. Afterwards it is changed in the console (Platform › Plugin installs).
# PGW_CACHE_DEFAULT_MODE=off

# ---------------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------------

# Grafana administrator. The password is applied when Grafana creates its database, on the
# first start; later changes are made in Grafana.
#   openssl rand -base64 18
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Public address of Grafana: https://<console host>/grafana/ (add the port if PGW_HTTPS_PORT
# is not 443).
GRAFANA_ROOT_URL=https://console.localhost/grafana/

# Where the console's Monitoring page links to Grafana; empty hides the link. Usually the same
# as GRAFANA_ROOT_URL, for those whose address PGW_ADMIN_ALLOW_CIDRS lets through.
PGW_GRAFANA_URL=

# How long Prometheus keeps metrics.
PROMETHEUS_RETENTION=30d

# The logs follow pacod-demo/docs/LOGGING.md (runbook, section 10).
# Level of the core, the analytics service and the load agent: debug, info, warn or error, or a
# tracing-subscriber filter (info,pacod_gw_core=debug). Anything else is info.
RUST_LOG=info

# Log format of the core, the analytics service, the tester, the load agent and pacod-id:
# json (one JSON object per line) or text (one readable line per event). Anything else is json.
PGW_LOG_FORMAT=json

# Level of the tester: debug, info, warn or error.
# TESTER_LOG_LEVEL=info

# Format of Caddy's access log: exactly json or console (Caddy's name for text), in lower case.
# Caddy does not start with any other value.
# PGW_CADDY_LOG_FORMAT=json

# ---------------------------------------------------------------------------------------------
# Tester (the console's Testing page, platform admins only)
# ---------------------------------------------------------------------------------------------
# A scripted mock provider for mock mode, as the gateway reaches it. Empty: only live mode is
# offered, with models that are already set up. The development stack sets both to gw-mock.
TESTER_MOCK_URL=
# The mock as the tester reaches it, to script failures. Empty: the same as TESTER_MOCK_URL.
TESTER_MOCK_CONTROL_URL=

# ---------------------------------------------------------------------------------------------
# Load tests (docker-compose.load.yml; docs/testing.md, section 9)
# ---------------------------------------------------------------------------------------------
# Read only when docker-compose.load.yml is added ("make up LOAD_TEST=1").
#
# The token the tester and every load agent share. Agents on other machines get the same value
# as LOAD_AGENT_TOKEN (deploy/load-agent/.env). At least 32 characters.
#   openssl rand -hex 32
TESTER_LOAD_TOKEN=
# The agents the tester offers, name=URL separated by commas. "local" is the agent in this
# stack; add agents on other machines by their private address.
# TESTER_LOAD_AGENTS=local=http://gw-load-agent:8096,eu-1=http://10.0.0.21:8096
# The local agent's way to this gateway: the core directly (the default), or Caddy's balanced
# data plane in the scale layout (http://pacod-caddy:8088).
# LOAD_AGENT_TARGET_URL=http://pacod-gw:8080
# The mock provider of load tests, as the gateway reaches it. Add its host (gw-load-mock) to
# PGW_EGRESS_ALLOW_PRIVATE above.
# TESTER_LOAD_MOCK_URL=http://gw-load-mock:9000
# The most calls a load test against a live model may make, and the longest a load test lasts
# (seconds).
# TESTER_LOAD_LIVE_MAX_CALLS=1000
# TESTER_LOAD_MAX_DURATION=3600
