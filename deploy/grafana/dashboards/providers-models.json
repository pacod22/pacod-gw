    {
      "type": "timeseries",
      "title": "Failed calls by model",
      "description": "Share of calls that failed, per provider and model. The dashed line is the alert threshold.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(gw_requests_total{provider=~\"$provider\", model=~\"$model\", outcome!~\"ok|cancelled\"}[$__rate_interval])) / sum by (provider, model) (rate(gw_requests_total{provider=~\"$provider\", model=~\"$model\", outcome!=\"cancelled\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / {{model}}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
