        "definition": "label_values(gw_requests_total, organisation)",
        "query": {
          "qryType": 1,
          "query": "label_values(gw_requests_total, organisation)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
