        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (organisation, workspace) (rate(gw_requests_total{organisation=~\"$organisation\", workspace=~\"$workspace\"}[5m])) > 0)",
