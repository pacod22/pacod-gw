        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(histogram_quantile(0.99, sum by (le, mode) (rate(gw_delay_seconds_bucket{provider=~\"$provider\", stage=\"total\"}[5m]))))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
