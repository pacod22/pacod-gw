  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "organisation",
        "label": "Organisation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(gw_requests_total, organisation)",
        "query": {
          "qryType": 1,
          "query": "label_values(gw_requests_total, organisation)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(gw_requests_total{organisation=~\"$organisation\"}, workspace)",
        "query": {
          "qryType": 1,
          "query": "label_values(gw_requests_total{organisation=~\"$organisation\"}, workspace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(gw_requests_total, provider)",
        "query": {
          "qryType": 1,
          "query": "label_values(gw_requests_total, provider)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests per second",
      "description": "Logical calls per second, all outcomes.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(gw_requests_total{organisation=~\"$organisation\", workspace=~\"$workspace\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Failed calls",
      "description": "Share of calls that ended in an error or a timeout. Calls the client cancelled are left out. The alert fires above 10 %.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(gw_requests_total{organisation=~\"$organisation\", workspace=~\"$workspace\", provider=~\"$provider\", outcome!~\"ok|cancelled\"}[$__rate_interval])) / sum (rate(gw_requests_total{organisation=~\"$organisation\", workspace=~\"$workspace\", provider=~\"$provider\", outcome!=\"cancelled\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "–",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Spend in the selected range",
      "description": "Cost of the calls settled in the dashboard's time range, per currency.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (currency) (increase(gw_cost_micros_total{organisation=~\"$organisation\", workspace=~\"$workspace\", provider=~\"$provider\"}[$__range])) / 1e6",
          "legendFormat": "{{currency}}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
