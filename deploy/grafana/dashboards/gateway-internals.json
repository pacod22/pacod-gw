        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gw_delay_seconds_bucket{instance=~\"$instance\", mode=\"proxy\", stage=\"total\"}[5m])))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
