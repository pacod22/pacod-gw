# Settings of a gateway on another machine (deploy/node/docker-compose.yml). Copy this file
# to deploy/node/.env on that machine and fill it in. The file holds secrets: keep it
# readable by root only (chmod 600) and out of version control.
#
# The central host runs docker-compose.hub.yml; docs/runbook.md, section 9, walks through
# adding a gateway.

# ---------------------------------------------------------------------------------------------
# This gateway
# ---------------------------------------------------------------------------------------------

# Its name in the console, in metrics and in usage events. Unique across all instances, and
# kept for the life of the gateway: letters, digits, '.', '_' and '-'.
PGW_INSTANCE_ID=gateway-eu-1

# Shown as the host in the console's instance list.
PGW_NODE_HOSTNAME=gw-eu-1.internal

# This machine's private address: the central Caddy sends requests to it on
# PGW_NODE_DATA_PORT, the central Prometheus reads the metrics on PGW_NODE_METRICS_PORT.
# Unset: 127.0.0.1, which nobody else can reach.
PGW_NODE_BIND=10.0.0.11
PGW_NODE_DATA_PORT=8080
PGW_NODE_METRICS_PORT=9100

# Whose X-Forwarded-For this gateway believes: the central host's private address (Caddy).
# Without it every client looks like the central host to the bad-key throttle.
PGW_TRUSTED_PROXIES=10.0.0.10

# The image, as on the central host.
PGW_REGISTRY=
PGW_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# The central host (docker-compose.hub.yml there)
# ---------------------------------------------------------------------------------------------

# PostgreSQL, with the central POSTGRES_PASSWORD. Add "?sslmode=require" when PostgreSQL
# offers TLS (docs/runbook.md).
DATABASE_URL=postgres://pacod_gw:POSTGRES_PASSWORD@10.0.0.10:5432/pacod_gw

# The analytics service: usage events and audit records go there.
PGW_ANALYTICS_URL=http://10.0.0.10:8090

# The trace collector. Empty: no traces.
PGW_OTLP_ENDPOINT=http://10.0.0.10:4318

# Connections to PostgreSQL. Every gateway takes this many of the central 100.
PGW_DB_MAX_CONNECTIONS=4

# The response cache's Valkey, with the central PGW_VALKEY_PASSWORD, so that this gateway
# shares the answers the others keep. Empty: it keeps answers in its own memory.
PGW_VALKEY_URL=redis://10.0.0.10:6379/0
PGW_VALKEY_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Secrets shared with the central host: copy them from its deploy/.env
# ---------------------------------------------------------------------------------------------
#
# They must be the same on every instance. A gateway with another PGW_KEY_PEPPER refuses
# every key; one with another PGW_KEK cannot read the provider credentials. The console
# raises a critical alert for either.

PGW_KEK=
# The name of that key, as on the central host ("default" if it is not set there). Every
# stored credential names the key it was sealed under.
PGW_KEK_ID=
PGW_KEK_OLD=
PGW_KEY_PEPPER=
PGW_INTERNAL_TOKEN=

# Providers on private networks, as on the central host. Every provider's base URL must be
# reachable from this machine too.
PGW_EGRESS_ALLOW_PRIVATE=

# Logging (pacod-demo/docs/LOGGING.md): a level (debug, info, warn, error) or a filter, and json
# or text.
RUST_LOG=info
PGW_LOG_FORMAT=json
