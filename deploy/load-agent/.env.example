# Settings of a load agent on another machine (deploy/load-agent/docker-compose.yml).
# Copy this file to deploy/load-agent/.env and fill it in. It holds the token the agent shares
# with the central tester: keep it readable by its owner only (chmod 600) and out of version
# control.

# ---------------------------------------------------------------------------------------------
# Image (read by Compose only)
# ---------------------------------------------------------------------------------------------
PGW_REGISTRY=
PGW_VERSION=0.1.0

# ---------------------------------------------------------------------------------------------
# Who the agent is, and who reaches it
# ---------------------------------------------------------------------------------------------
# The name the console shows; the same name as in the central TESTER_LOAD_AGENTS.
LOAD_AGENT_NAME=eu-1
# Where the agent is published for the central tester: this machine's private address. 0.0.0.0
# opens it on every interface.
LOAD_AGENT_BIND=127.0.0.1
LOAD_AGENT_PORT=8096
# The token the tester presents: copy TESTER_LOAD_TOKEN from the central host's deploy/.env, do
# not generate a new one. At least 32 characters.
LOAD_AGENT_TOKEN=

# ---------------------------------------------------------------------------------------------
# The gateway it loads
# ---------------------------------------------------------------------------------------------
# This gateway as clients reach it from this machine: the public API host, so that the load
# goes through Caddy and TLS as applications' calls do. A load test against an external gateway
# names its own URL instead.
LOAD_AGENT_TARGET_URL=https://api.example.com
# A gateway behind a private CA (Caddy's "tls internal", for example): put its certificates in a
# directory, as PEM, and name the file here as the container sees it.
# LOAD_AGENT_CA_DIR=./ca
# LOAD_AGENT_CA_FILE_IN_CONTAINER=/etc/pacod-gw/ca/root.crt

# ---------------------------------------------------------------------------------------------
# The most it makes, whatever a test asks for
# ---------------------------------------------------------------------------------------------
LOAD_AGENT_MAX_CONCURRENCY=10000
LOAD_AGENT_MAX_RATE=5000
# Seconds.
LOAD_AGENT_MAX_DURATION=3600
# CPUs the container may use. The agent warns the console when it comes close: its figures
# would then describe itself rather than the gateway.
LOAD_AGENT_CPUS=4.0

# Logging (pacod-demo/docs/LOGGING.md): json or text, and a level (debug, info, warn, error) or
# a filter.
LOAD_AGENT_LOG_FORMAT=json
RUST_LOG=info
