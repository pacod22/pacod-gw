# Caddy in front of pacod-gw: pacod-caddy of the gateway's own production stack
# (docker-compose.standalone.yml). It terminates TLS for three host names:
#
#   PGW_API_HOST      the data plane (pacod-gw, port 8080): /v1, /gw/v1, /proxy, /healthz, /readyz
#   PGW_CONSOLE_HOST  the admin console (gw-console, port 3000)
#   PGW_ID_HOST       pacod-id, where people sign in (pacod-id, port 8070)
#
# The gateway's two sites are in platform/caddy/gw.caddy, the fragment the full stack (pacod-demo)
# imports as well; docker-compose.standalone.yml mounts platform/caddy at /etc/caddy/sites and
# gives the fragment its addresses: GW_API_SITE is PGW_API_HOST plus http://:8088, GW_CONSOLE_SITE
# is PGW_CONSOLE_HOST. This file holds the global options, the import, and what only the
# gateway's own stack serves: pacod-id's site.
#
# Caddy balances the data plane over the gateway instances listed in PGW_DATA_UPSTREAMS, on this
# host or on others (docs/runbook.md, section 9), and offers the same balancing inside the stack
# on http://pacod-caddy:8088 for the tester and the load agent.
#
# PGW_TLS decides where the certificates come from:
#
#   internal             Caddy's own certificate authority. For localhost and for tests.
#                        Clients must trust the root certificate or skip verification.
#   an e-mail address    Automatic certificates from Let's Encrypt for real domains. The
#                        address becomes the contact of the ACME account. The three host
#                        names must resolve to this host and ports 80 and 443 must be reachable.
#
# Values of the form {$NAME:default} are read from the environment when Caddy starts
# (deploy/.env through docker-compose.standalone.yml).
{
	# Uncomment when a load balancer or CDN sits in front of Caddy, and list its addresses.
	# Caddy then keeps the X-Forwarded-For chain it receives from them. Set XFF_DEPTH of the
	# gw-console service to match (one more per trusted hop).
	# servers {
	# 	trusted_proxies static 10.0.0.0/8
	# }

	# Caddy's own messages, such as a failed proxy request, include the request as well.
	# They are written like the access logs (pacod-demo/docs/LOGGING.md, section 6): in
	# PGW_CADDY_LOG_FORMAT, json or console, and without one-time tokens, sign-in values and
	# keys.
	log default {
		output stdout
		format filter {
			wrap {$PGW_CADDY_LOG_FORMAT:json}
			fields {
				request>uri query {
					delete token
					# After signing in: may lead back to an invitation link.
					delete next
					# Signing in through pacod-id: the code, its state, the hint at sign-out,
					# the address, the flow of a sign-in under way.
					delete code
					delete state
					delete id_token_hint
					delete login_hint
					delete flow
					# Gateway keys in Google's ?key=.
					delete key
				}
				request>headers>Referer delete
				# The redirects carry the same values: back to the console with the code, on to
				# pacod-id with an invitation's token.
				resp_headers>Location delete
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
			}
		}
	}
}

# The gateway's sites and their snippets (gw_data_plane, gw_common_headers, ...), which the
# site below uses: an import must come before the snippets it defines are used.
import /etc/caddy/sites/*.caddy

# ---------------------------------------------------------------------------------------------
# pacod-id host: its sign-in pages and the OpenID Connect endpoints browsers use (the public
# listener). The internal listener (8071) is not exposed: the core, the console and the tester
# reach it on pacod-net.
# ---------------------------------------------------------------------------------------------
{$PGW_ID_HOST:id.localhost} {
	tls {$PGW_TLS:internal}
	import gw_common_headers
	# pacod-id sends its own Content-Security-Policy and frame rules.

	encode zstd gzip

	request_body {
		max_size 1MB
	}

	# pacod-id reads the client's address from X-Forwarded-For (PID_TRUSTED_PROXIES).
	reverse_proxy pacod-id:8070

	# One-time values travel in the query: invitation, reset and confirmation links (token),
	# the sign-in's code and state, the hint at sign-out, the address as login_hint, the
	# flow of a sign-in under way. They are not written to the log.
	log {
		output stdout
		format filter {
			wrap {$PGW_CADDY_LOG_FORMAT:json}
			fields {
				request>uri query {
					delete token
					delete code
					delete state
					delete id_token_hint
					delete login_hint
					delete flow
					delete next
					delete key
				}
				request>headers>Referer delete
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
				# The redirects carry the same values: back to the console with the code, on to
				# pacod-id with an invitation's token.
				resp_headers>Location delete
			}
		}
	}
}
