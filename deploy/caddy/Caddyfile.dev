# Caddy for the development stack: pacod-caddy of docker-compose.standalone.dev.yml. Plain HTTP
# on port 13000 in front of the console. No certificates to trust.
#
# The gateway's sites are in platform/caddy/gw.caddy (mounted at /etc/caddy/sites), the fragment
# the full stack imports as well; docker-compose.standalone.dev.yml gives them their development
# addresses: the console on http://:13000 (GW_CONSOLE_SITE) and the data plane balanced over the
# gateway instances on http://:8088 (GW_API_SITE), published as 18080 with the scale layout
# (docker-compose.scale.dev.yml). This file holds the global options, the import and pacod-id's
# site.
#
# The console is reached through Caddy even in development because it builds its origin
# from the Host header and X-Forwarded-Proto. reverse_proxy passes Host unchanged and sets
# X-Forwarded-Proto to "http" and X-Forwarded-For to the client address, so the origin is
# http://localhost:13000, which is what the browser sends.
#
# pacod-id's public listener is behind Caddy on http://127.0.0.1:13070, its issuer; its
# internal listener (18071) and metrics (19170) are published straight from the container.
#
# The data plane, the management API and the other services are published straight from
# their containers; see the port list in docker-compose.dev.yml.
#
# As in production, Caddy also serves https://api.localhost (the data plane) and
# https://console.localhost (the console) on ports 80 and 443, with certificates from its own
# certificate authority, when docker-compose.dev.https.yml adds those addresses to GW_API_SITE
# and GW_CONSOLE_SITE and publishes the ports ("make dev-up DEV_HTTPS=1").
#
# From another machine, the console works over HTTPS only: its session cookie is "Secure",
# and a browser keeps such a cookie from plain HTTP only for localhost and 127.0.0.1. For a
# development stack on a machine of its own, PGW_DEV_CONSOLE_HOST and PGW_DEV_API_HOST name
# the addresses of the two HTTPS sites (runbook, section 11).
{
	# The certificate for clients that send no server name, which is what a client that
	# connects to an IP address does. Set PGW_DEV_DEFAULT_SNI to that address when one of the
	# HTTPS sites lists one; Caddy cannot match it by the address the client used, which
	# Docker's port publishing hides from it.
	default_sni {$PGW_DEV_DEFAULT_SNI:console.localhost}

	# Every certificate from Caddy's own certificate authority: the development stack must never
	# ask Let's Encrypt, whatever deploy/.env says. The sites carry no tls directive here
	# (GW_SITE_TLS is not set).
	local_certs

	# Development only: a test client may claim any address in X-Forwarded-For, so that the
	# per-client behaviour of the gateways can be tried through the balancer. In production
	# the Caddyfile trusts no one by default.
	servers {
		trusted_proxies static private_ranges
	}

	# Caddy's own messages, such as a failed proxy request, include the request as well.
	# They are written like the access logs (pacod-demo/docs/LOGGING.md, section 6): in
	# PGW_CADDY_LOG_FORMAT, json or console, and without one-time tokens, sign-in values and
	# keys.
	log default {
		output stdout
		format filter {
			wrap {$PGW_CADDY_LOG_FORMAT:console}
			fields {
				request>uri query {
					delete token
					# After signing in: may lead back to an invitation link.
					delete next
					# Signing in through pacod-id: the code, its state, the hint at sign-out,
					# the address, the flow of a sign-in under way.
					delete code
					delete state
					delete id_token_hint
					delete login_hint
					delete flow
					# Gateway keys in Google's ?key=.
					delete key
				}
				request>headers>Referer delete
				# The redirects carry the same values: back to the console with the code, on to
				# pacod-id with an invitation's token.
				resp_headers>Location delete
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
			}
		}
	}
}

# The gateway's sites and their snippets.
import /etc/caddy/sites/*.caddy

# pacod-id, the issuer http://127.0.0.1:13070 (pacod-id/pacod-id.dev.toml).
http://:13070 {
	reverse_proxy pacod-id:8070

	log {
		output stdout
		format filter {
			wrap {$PGW_CADDY_LOG_FORMAT:console}
			fields {
				request>uri query {
					delete token
					delete code
					delete state
					delete id_token_hint
					delete login_hint
					delete flow
					delete next
					delete key
				}
				request>headers>Referer delete
				request>headers>X-Api-Key delete
				request>headers>X-Goog-Api-Key delete
				# The redirects carry the same values: back to the console with the code, on to
				# pacod-id with an invitation's token.
				resp_headers>Location delete
			}
		}
	}
}
