# Settings of the minimal gateway, pacod-gw-lite (deploy/lite/docker-compose.yml, docs/lite.md).
# Copy this file to deploy/lite/.env and fill it in. It is the gateway's only configuration and
# holds provider keys: keep it readable by its owner only (chmod 600) and out of version
# control. `docker compose run --rm pacod-gw check` shows what the gateway reads from it.
#
# Variables of objects are named PGW_<KIND>_<LABEL>[_<ATTRIBUTE>]. The label is capital letters
# and digits only (no underscore); it groups the variables of one object. An empty value counts
# as unset. Values are taken literally, except that "$$" stands for "$": Compose reads a single
# "$" as the start of a variable.

# ---------------------------------------------------------------------------------------------
# Image and port (read by Compose only)
# ---------------------------------------------------------------------------------------------

PGW_REGISTRY=
PGW_VERSION=0.1.0
# Where the gateway is published on this machine. 127.0.0.1 keeps it to local clients; use a
# private address (or 0.0.0.0 behind a firewall) for clients on other machines. The gateway
# speaks plain HTTP: put a TLS proxy in front of it for anything that crosses a network.
PGW_LITE_BIND=127.0.0.1
PGW_LITE_PORT=14080

# ---------------------------------------------------------------------------------------------
# Providers: PGW_PROVIDER_<LABEL>_...
# ---------------------------------------------------------------------------------------------
# The label in lower case is the provider's name, as in model names ("anthropic/…") and in
# proxy paths (/proxy/anthropic/…). A name that is a preset needs nothing but its key:
# openai, anthropic, gemini, gemini-openai, vertex, vertex-express, glm, glm-cn, deepseek, xai,
# kimi, kimi-cn, ollama, ollama-cloud.
#
#   _KEY              the provider's API key
#   _KEY_FILE         or a file holding it (a mounted Docker secret; Vertex AI: the service
#                     account's JSON key)
#   _PRESET           the preset, when the name is not one
#   _NAME             the name, when it needs a '-' (the label cannot hold one)
#   _BASE_URL         another endpoint than the preset's
#   _TIMEOUT_SECONDS  how long to wait for the provider (default PGW_TIMEOUT_SECONDS)

PGW_PROVIDER_OPENAI_KEY=
PGW_PROVIDER_ANTHROPIC_KEY=

# PGW_PROVIDER_DEEPSEEK_KEY=
# PGW_PROVIDER_GLM_KEY=
# PGW_PROVIDER_GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# PGW_PROVIDER_GEMINI_KEY=
# PGW_PROVIDER_GOAI_NAME=gemini-openai
# PGW_PROVIDER_GOAI_KEY=
# PGW_PROVIDER_VERTEX_KEY_FILE=/run/secrets/vertex.json
# PGW_PROVIDER_VERTEX_BASE_URL=https://europe-west4-aiplatform.googleapis.com/v1/projects/my-project/locations/europe-west4/publishers/google
# A local model server: allow its host in PGW_EGRESS_ALLOW_PRIVATE as well.
# PGW_PROVIDER_LOCAL_PRESET=ollama
# PGW_PROVIDER_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# PGW_PROVIDER_LOCAL_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------------------------
# Models: PGW_MODEL_<LABEL>=<name clients use>
# ---------------------------------------------------------------------------------------------
# A name "<provider>/<model id at the provider>" needs nothing else. The kind (chat, embedding,
# speech) and the capability preset are guessed from the model id; `check` shows the guess.
#
#   _PROVIDER         the provider, when the name does not start with it
#   _UPSTREAM         the model's id at the provider, when it differs from the name
#   _KIND             chat, embedding or speech
#   _CAPABILITIES     the capability preset (docs/lite.md lists them)
#   _CONTEXT          context window, tokens
#   _MAX_OUTPUT       most output tokens
#   _PRICE            rates per million tokens, for the cost in the log: input, output,
#                     cache_read, cache_write_5m, cache_write_1h, reasoning; per_character
#                     (speech), per_request, per_server_tool_call. Or "free".
#   _CURRENCY         of the price (default PGW_CURRENCY)
#
# The prices below are examples: take the provider's current price list.

PGW_MODEL_SONNET=anthropic/claude-sonnet-5-5
PGW_MODEL_SONNET_PRICE=input=3,output=15,cache_read=0.3,cache_write_5m=3.75
PGW_MODEL_LUNA=openai/gpt-5.6-luna
PGW_MODEL_LUNA_PRICE=input=0.25,output=2,cache_read=0.025

# PGW_MODEL_TTS=openai/gpt-4o-mini-tts
# PGW_MODEL_EMBED=openai/text-embedding-3-small
# PGW_MODEL_FLASH=gemini-3.8-flash
# PGW_MODEL_FLASH_PROVIDER=gemini
# PGW_MODEL_LLAMA=local/llama3.3
# PGW_MODEL_LLAMA_PRICE=free

# ---------------------------------------------------------------------------------------------
# Pools: PGW_POOL_<LABEL>=<model>,<model>,...
# ---------------------------------------------------------------------------------------------
# Clients call a pool as the model "@<label in lower case>". The models are tried in the order
# given: the next one takes over on a 429, a 5xx or a lost connection, before the first byte
# of the answer. Up to 8 models.
#
#   _NAME             the name, when it needs a '-'
#   _ALGORITHM        priority (the default), weighted, round_robin, weighted_round_robin,
#                     least_in_flight, lowest_latency, cheapest
#   _WEIGHTS          one per model, for the weighted algorithms; 0 keeps a model as backup
#   _TIMEOUT_SECONDS  how long each model gets (up to 600)
#   _RETRIES          attempts per model, 1 to 5 (default 1 in a pool)

PGW_POOL_FAST=openai/gpt-5.6-luna,anthropic/claude-sonnet-5-5

# ---------------------------------------------------------------------------------------------
# Clients: PGW_CLIENT_<LABEL>_...
# ---------------------------------------------------------------------------------------------
# Every application that calls the gateway gets a key. The label in lower case is the name
# each log line shows. Make a key with
#   docker compose run --rm pacod-gw keygen <name>
#
#   _KEY              the client's key: pgw_<name>_<secret>
#   _KEY_FILE         or a file holding it
#   _RPM              requests per minute
#   _TPM              tokens per minute
#   _CONCURRENCY      calls at the same time
#   _MODELS           what the client may call: models and @pools. Unset: everything.
#
# Limits are counted in memory: they start again from zero when the gateway restarts.

PGW_CLIENT_APP_KEY=
# PGW_CLIENT_APP_RPM=600
# PGW_CLIENT_APP_TPM=2000000
# PGW_CLIENT_APP_CONCURRENCY=20
# PGW_CLIENT_APP_MODELS=anthropic/claude-sonnet-5-5,@fast

# ---------------------------------------------------------------------------------------------
# Intent plugin: PGW_INTENT_... (docs/lite.md, section 12)
# ---------------------------------------------------------------------------------------------
# Classifies what each call asks for against a catalogue of intents, logs the intent, and
# blocks or flags calls by the catalogue's rules. Off unless PGW_INTENT_MODE is set.
#
#   _MODE             shadow (classify alongside the call, never block) or enforce (classify
#                     first; the rules block and flag)
#   _FILE             the catalogue: YAML, or JSON when the name ends in .json. Mount it into
#                     the container (deploy/lite/intents.example.yaml is a start)
#   _ENGINE           llm (a chat model classifies, the default), jev (TypeSafe's Jev) or
#                     cascade (Jev first, the chat model when Jev is unsure)
#   _MODEL            llm and cascade: the chat model or @pool that classifies
#   _JEV_MODEL        jev and cascade: the decision model; unset takes the only one there is
#   _ON_ERROR         enforce: closed (refuse calls when no verdict comes, the default) or open
#   _TIMEOUT_MS       how long a call waits for the verdict
#   _EXPOSE           true tells clients the intent in the x-gw-intent header
#
# Every classification is a model call of its own, logged with the classified call's id as
# its parent_id and priced like any other. Jev sends the text to TypeSafe, a third party in the
# United States: setting PGW_INTENT_ENGINE to jev or cascade is the approval.

# PGW_INTENT_MODE=shadow
# PGW_INTENT_FILE=/etc/pacod-gw/intents.yaml
# PGW_INTENT_ENGINE=llm
# PGW_INTENT_MODEL=openai/gpt-5.6-luna
# PGW_INTENT_ON_ERROR=closed
# PGW_INTENT_TIMEOUT_MS=3000
# PGW_INTENT_EXPOSE=false
#
# With Jev, TypeSafe is a provider and Jev a model of kind decision. TypeSafe charges input
# only; it reports output tokens, so the output price is 0 rather than missing:
# PGW_PROVIDER_TYPESAFE_KEY=
# PGW_MODEL_JEV=typesafe/jev-1.13.0
# PGW_MODEL_JEV_PRICE=input=0.042,output=0
# PGW_INTENT_JEV_MODEL=typesafe/jev-1.13.0

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------

# text (one readable line per call) or json (one JSON object per line).
PGW_LOG_FORMAT=text
# The level and what is logged: "info" logs every call. Bad keys and other refused requests
# are logged at "info" too; model listings at "debug".
RUST_LOG=info
# Request and response bodies in the log as well: off, on (every call) or on_request (calls
# that send "x-gw-audit: true"). Bodies hold what users wrote: switch this on only where that
# is allowed, and mind the size of the log.
PGW_LOG_BODIES=off
# Bodies are cut after this many bytes each.
# PGW_LOG_BODY_MAX_BYTES=16384

# ---------------------------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------------------------

# Parameters a model does not take: drop them (and say so in the response) or reject the call.
# PGW_UNSUPPORTED_PARAMS=drop
# The currency of prices that name none, and of the costs in the log.
# PGW_CURRENCY=USD
# How long to wait for a provider, in seconds: for a stream, until its first byte.
# PGW_TIMEOUT_SECONDS=180
# Seconds without a byte from the provider after which a stream is ended.
# PGW_STREAM_IDLE_SECONDS=120
# Largest request body in bytes (32 MiB), and calls in flight before 503 gateway_overloaded.
# PGW_MAX_BODY_BYTES=33554432
# PGW_MAX_IN_FLIGHT=10000
# Hosts or CIDR ranges on private networks where providers may live, comma separated. Every
# other private, link-local or loopback address is refused as a provider address.
# PGW_EGRESS_ALLOW_PRIVATE=host.docker.internal
# Proxies whose X-Forwarded-For the gateway believes, comma separated (addresses or CIDR).
# Without one, a client's address is the connection's.
# PGW_TRUSTED_PROXIES=
# On stop: how long running calls may finish, and how long to report "not ready" first.
# PGW_DRAIN_SECONDS=30
# PGW_DRAIN_DELAY_SECONDS=0
