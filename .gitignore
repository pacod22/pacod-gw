# Rust
/target/

# UI
node_modules/
ui/.svelte-kit/
ui/build/

# Local config and secrets
.env
config/gateway.toml

.DS_Store
.idea/
# Local settings of coding assistants
.claude/
.kilo/

# Tester
tester/.venv/
tester/.data/
tester/.data.log
**/__pycache__/
tester/.pytest_cache/
tester/.ruff_cache/

# The operator's own models file (deploy/models/models.example.json is the example)
deploy/models/*
!deploy/models/models.example.json

# Prometheus targets of gateways on other machines (deploy/prometheus/targets/nodes.yml.example)
deploy/prometheus/targets/nodes.yml

# Certificates and keys of Valkey's TLS (deploy/valkey/tls/README.md, deploy/node/tls/README.md)
deploy/valkey/tls/*
!deploy/valkey/tls/README.md
deploy/node/tls/*
!deploy/node/tls/README.md

# gw-broker's file and token files (deploy/broker/gw-broker.example.yaml is the template).
deploy/broker/*
!deploy/broker/gw-broker.example.yaml
